[Unit]
Description=trader-agent rule-baseline paper loop (records streams too)
After=network-online.target
Wants=network-online.target
Conflicts=trader-streams.service

[Service]
User=trader
WorkingDirectory=/opt/trader-agent
EnvironmentFile=/etc/trader-agent/env
Environment=HOME=/var/lib/trader-agent/home
ExecStart=/opt/trader-agent/.venv/bin/python -m trader_agent run-paper --run-id study
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trader-agent
PrivateTmp=true

[Install]
WantedBy=multi-user.target

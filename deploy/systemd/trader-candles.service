[Unit]
Description=trader-agent Nobitex candle backfill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/opt/trader-agent
EnvironmentFile=/etc/trader-agent/env
ExecStart=/opt/trader-agent/.venv/bin/python -m trader_agent collect-candles
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trader-agent
PrivateTmp=true

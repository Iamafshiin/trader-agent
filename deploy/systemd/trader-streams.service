[Unit]
Description=trader-agent Nobitex stream recorder
After=network-online.target
Wants=network-online.target

[Service]
User=trader
WorkingDirectory=/opt/trader-agent
EnvironmentFile=/etc/trader-agent/env
ExecStart=/opt/trader-agent/.venv/bin/python -m trader_agent collect-streams
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trader-agent
PrivateTmp=true

[Install]
WantedBy=multi-user.target
